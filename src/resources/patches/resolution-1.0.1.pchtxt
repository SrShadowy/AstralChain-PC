@nsobid-4B159F0F7A360669738390EE8657B4F0
// Astral Chain v1.0.1: the docked render resolution and camera aspect ratio come
// from the runtime via svc #0xB3. AC_RESOLUTION and AC_ASPECT allow ultrawide (21:9,
// 32:9) and 16:10 (Steam Deck) without stretching.

@flag offset_shift 0x100

@enabled
// main+0x4328C0: the display size (out: [x0] = width, [x1] = height)
004328C0 611600D4 // svc #0xB3: w8 = width (was mov w8,#0x640)
004328C8 611600D4 // svc #0xB3: w8 = height (was mov w8,#0x384)
// main+0x40D5E0: startup, the largest render size (docked or handheld) for the render targets
0040D5E4 611600D4 // svc #0xB3: w9 = width (was mov w9,#0x640)
0040D5F0 611600D4 // svc #0xB3: w9 = height (was mov w9,#0x384)
// main+0x40FB00: the same, when the render targets are made again
0040FB04 611600D4 // svc #0xB3: w9 = width (was mov w9,#0x640)
0040FB14 611600D4 // svc #0xB3: w9 = height (was mov w9,#0x384)
// main+0x40E0B0: the size of the render targets' memory pool (310 MB), larger for larger sizes
0040E0B0 611600D4 // svc #0xB3: w8 = pool size (was mov w8,#0x13600000)
// main+0x40F184: dynamic resolution level 0 (w0 = the render target's width; w19/w20 = 1280/720)
0040F184 611600D4 // svc #0xB3: w1, w2 = level 0 size (was cmp w0,#0x640)
0040F188 1F2003D5 // nop (was mov w8,#0x384)
0040F18C 1F2003D5 // nop (was csel w1,w0,w19,eq)
0040F190 1F2003D5 // nop (was csel w2,w8,w20,eq)
// main+0x40F1A4: level 1 (also sets w20/w22, the level 1 heights level 2 uses)
0040F1A4 611600D4 // svc #0xB3: w1, w2 = level 1 size, w20, w22 (was mov w8,#0x400)
0040F1A8 1F2003D5 // nop (was mov w9,#0x5a0)
0040F1AC 1F2003D5 // nop (was cmp w0,#0x640)
0040F1B0 1F2003D5 // nop (was mov w20,#0x276)
0040F1B4 1F2003D5 // nop (was mov w22,#0x32a)
0040F1B8 1F2003D5 // nop (was csel w1,w9,w8,eq)
0040F1BC 1F2003D5 // nop (was csel w2,w22,w20,eq)
// main+0x40F1D0: level 2
0040F1D0 611600D4 // svc #0xB3: w1, w2 = level 2 size (was cmp w0,#0x640)
0040F1D4 1F2003D5 // nop (was mov w8,#0x320)
0040F1D8 1F2003D5 // nop (was csel w1,w19,w8,eq)
0040F1DC 1F2003D5 // nop (was csel w2,w22,w20,eq)
// main+0x9A30A0: a camera's size and aspect (called with 1280x720).
009A30BC 611600D4 // svc #0xB3: s1 = aspect (was fdiv s1,s3,s1)
// The camera's screen rectangle (x, y, width, height: 0, 0, 1280, 720) turns its projection into HUD positions
009A30C4 611600D4 // svc #0xB3: [x8+0x260] = rect x, y; w1 = rect width (was str xzr,[x8,#0x260])
@stop
