static void stop_dump(Cpu *c);
/* AC_CRASH_DUMP=1 (the launcher's diagnostics mode): a minidump of the fault, crash.dmp in the run folder. Thread
 * stacks and registers only (no guest heap); read it with trace.pdb. */
static void crash_minidump(PEXCEPTION_POINTERS info) {
 if(!GetEnvironmentVariableA("AC_CRASH_DUMP",NULL,0)) return;
 typedef BOOL (WINAPI *WriteDump)(HANDLE,DWORD,HANDLE,MINIDUMP_TYPE,PMINIDUMP_EXCEPTION_INFORMATION,
  PMINIDUMP_USER_STREAM_INFORMATION,PMINIDUMP_CALLBACK_INFORMATION);
 HMODULE dbghelp=LoadLibraryA("dbghelp.dll");
 WriteDump write=dbghelp ? (WriteDump)(void*)GetProcAddress(dbghelp,"MiniDumpWriteDump") : NULL;
 HANDLE file=write ? CreateFileA("crash.dmp",GENERIC_WRITE,0,NULL,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL) : INVALID_HANDLE_VALUE;
 if(file==INVALID_HANDLE_VALUE) {fputs("CRASH_DUMP not written\n",stderr);return;}
 MINIDUMP_EXCEPTION_INFORMATION exception={GetCurrentThreadId(),info,FALSE};
 BOOL ok=write(GetCurrentProcess(),GetCurrentProcessId(),file,
  (MINIDUMP_TYPE)(MiniDumpWithThreadInfo|MiniDumpWithUnloadedModules),&exception,NULL,NULL);
 CloseHandle(file);
 fprintf(stderr,"CRASH_DUMP %s\n",ok ? "crash.dmp" : "failed");
}
static LONG CALLBACK fatal_fault_handler(PEXCEPTION_POINTERS info) {
 fflush(stdout);
 nvn_dump_recent();
 /* Host location: module + offset, and the faulting host thread (backend workers fault too). */
 HMODULE module=NULL;char name[MAX_PATH]="?";uintptr_t at=(uintptr_t)info->ExceptionRecord->ExceptionAddress;
 if(GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,(LPCSTR)at,&module))
  GetModuleFileNameA(module,name,sizeof(name));
 fprintf(stderr,"FAULT code=0x%lx guest_pc=0x%llx address=0x%llx host=%s+0x%llx thread=%lu\n",
 info->ExceptionRecord->ExceptionCode,(unsigned long long)state.pc,
 (unsigned long long)(info->ExceptionRecord->NumberParameters>1 ? info->ExceptionRecord->ExceptionInformation[1] : 0),
 strrchr(name,'\\') ? strrchr(name,'\\')+1 : name,(unsigned long long)(at-(uintptr_t)module),GetCurrentThreadId());
 fflush(stderr);
 crash_minidump(info);
 fflush(stderr); ExitProcess(32);
}
__attribute__((noreturn)) static void boundary(const char *kind, Cpu *c, uint64_t pc) {
 snapshot();
 if(application_terminate_result_set) printf("APPLICATION_TERMINATE_RESULT 0x%x\n",application_terminate_result);
 printf("COUNTERS calls=%u syscalls=%u\n",calls,syscalls);
 unsigned count=calls<64 ? calls : 64;
 for(unsigned i=0;i<count;i++) {
  unsigned slot=(calls-count+i)%64;
  printf("RECENT_CALL 0x%llx 0x%llx\n",(unsigned long long)recent_calls[slot].from,(unsigned long long)recent_calls[slot].target);
 }
 nvn_dump_recent();
 stop_dump(c);
 printf("STOP %s pc=0x%llx",kind,(unsigned long long)pc);
 for(unsigned i=0;i<8;i++) printf(" x%u=0x%llx",i,(unsigned long long)c->x[i]);
 printf("\n"); fflush(stdout); exit(20);
}
static void trace_call(uint64_t from,uint64_t target) {
 recent_calls[calls%64].from=from;recent_calls[calls%64].target=target;
 if(++calls>CALL_LIMIT) boundary("call-budget",&state,from);
 if(calls>10000) { if(calls==10001) puts("TRACE call lines capped at 10000; execution continues within step budget"); return; }
 printf("CALL 0x%llx 0x%llx\n",(unsigned long long)from,(unsigned long long)target);
}
